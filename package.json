{
  "name": "dbd-stats-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/godninoff/dbd-stats-electron.git"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
